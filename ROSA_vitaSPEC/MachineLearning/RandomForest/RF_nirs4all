rf_pipeline = [
    # -- A. PRÉTRAITEMENTS SPECTRAUX (sur X) --
    SNV(),  # Étape 1: Standard Normal Variate (corrige la diffusion)
    SavitzkyGolay(
        window_length=15, polyorder=2
    ),  # Étape 2: Lissage pour enlever le bruit instrumental
    # -- B. TRAITEMENT DE LA CIBLE (sur Y) --
    {"y_processing": StandardScaler()},  # Centre et réduit tes valeurs chimiques (Y)
    # -- C. SÉPARATION DES DONNÉES (Cross-Validation) --
