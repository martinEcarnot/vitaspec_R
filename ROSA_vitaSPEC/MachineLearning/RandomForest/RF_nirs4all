# %% IMPORTATIONS
import pandas as pd
import sys
from pathlib import Path
from pathlib import Path
import numpy as np

import nirs4all

# splitting pour la chimiometrie
from nirs4all.operators.splitters import KennardStoneSplitter
from sklearn.ensemble import RandomForestRegressor
from sklearn.preprocessing import StandardScaler

d0 = Path(
    "C:/Users/U108-N806/Documents/STAGE_M2_ROSA_NIRS/VitaSPEC/vitaspec_R/ROSA_vitaSPEC"
)
sys.path.append(str((d0 / "MachineLearning").resolve()))
from diy_functions.pre_translation import pre_translation


# %% chargement des donnees + pretrait

idparam = "meso_silica"
# idparam = "meso_frais"
# idparam = "HR"

DATA = d0 / "Data" / "dat" / "dat_mean_Meso_sec_2425_DIADE.csv"
param = d0 / "calibrations" / "Vitaspec_fruit_param.csv"
ech = "ech"

# DATA
df_data = pd.read_csv(DATA)
col_spectres = [col for col in df_data.columns if str(col).startswith("x.")]

liste_composes = []
for col in reversed(df_data.columns):
    if str(col).startswith("x."):
        break
    liste_composes.insert(0, col)

# pretrait
df_param = pd.read_csv(param)
# On filtre les paramètres pour ne garder que ceux de la modalité actuelle (ex: contient 'meso_silica')
df_param_mod = df_param[
    df_param["Cal_data"].str.contains(idparam, na=False, case=False)
]

print(f"{len(df_data)} échantillons.")
print(f"{len(col_spectres)} longueurs d'ondes")
print(
    f"Dictionnaire de prétraitements chargé pour '{idparam}' : {len(df_param_mod)} règles trouvées."
)

# %% BOUCLE SUR LES COMPOSES

resultats_globaux = {}

for compose in liste_composes:
    print(f"\n{'=' * 50}")
    print(f"Modélisation : {compose.upper()}")

    # filtre les échantillons valides
    df_compose = df_data.dropna(subset=[compose]).copy()

    if len(df_compose) == 0:
        print(f"Aucune donnée chimique valide pour {compose}. Modèle ignoré.")
        continue

    print(f"Échantillons valides : {len(df_compose)}")

    # construction du prétrait
    # On cherche la ligne correspondant au composé dans le CSV des paramètres
    regle_param = df_param_mod[df_param_mod["Propriete"] == compose]

    if len(regle_param) > 0:
        chaine_r = regle_param.iloc[0]["pre"]
        etapes_pretraitement = pre_translation(chaine_r)
        print(f"prétraitement: {etapes_pretraitement}")

    # extraction x et y
    X = df_compose[col_spectres].values
    y = df_compose[compose].values

    # pipeline nirs4all
    # On additionne la liste de prétraitements avec le reste
    pipeline = etapes_pretraitement + [
        KennardStoneSplitter(test_size=0.3),
        {"model": RandomForestRegressor(n_estimators=200, random_state=42, n_jobs=-1)},
    ]

    try:
        # Exécution du modèle
        resultat = nirs4all.run(X, y, pipeline=pipeline)

        # Récupération des métriques
        r2 = resultat.metrics["r2"]
        rmse = resultat.metrics["rmse"]

        print(f"✅ R² Prédiction : {r2:.3f} | RMSEP : {rmse:.3f}")

        # Sauvegarde
        resultats_globaux[compose] = {
            "R2": r2,
            "RMSEP": rmse,
            "Resultat_Objet": resultat,
        }

    except Exception as e:
        print(f"❌ Erreur lors de l'exécution pour {compose} : {e}")

print("\n🚀 Fin de l'analyse globale !")
